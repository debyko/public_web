# Cloudflare Pages publishes the whole repository. Working documents are not part of the site.
/README.md        /  302
/plans/*          /  302
/og/README.md     /  302
/og/*.svg         /  302
# Dated copies of a page kept before a rewrite are backups, not pages.
/index_*.html     /  302
# The Pages Function source is compiled by Pages; its file is not a page.
/functions/*      /  302
/_routes.json     /  302
